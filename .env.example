# Local persistence. db:local generates this securely for the project cluster.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/remix_drop
LOCAL_DEMO=true

# Optional connected AI. Leave both blank for offline Demo AI.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional server-only wardrobe image analysis. Set both in .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=
